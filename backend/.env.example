# ============================================
# MemoryBun Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# WARNING: Never commit .env files with real secrets to git!

# ===========================================
# Security Settings
# ===========================================

# Debug mode - ALWAYS set to False in production!
DEBUG=False

# CORS Origins - Comma-separated list of allowed origins
# For local development: CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'
# For production: CORS_ORIGINS='["https://yourdomain.com"]'
CORS_ORIGINS='["*"]'

# Admin API Key for Question Service admin routes
# Generate a secure random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me-in-production

# ===========================================
# LLM Configuration
# ===========================================

# LLM Provider: gemini, openai
LLM_PROVIDER=gemini

# LLM Model to use
LLM_MODEL=gemini-2.5-flash

# API Keys (store securely - use AWS Secrets Manager in production)
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# Use mock LLM responses (for testing without spending API credits)
MOCK_LLM_RESPONSE=False

# ===========================================
# Redis Configuration
# ===========================================

# Redis URL - update for production (ElastiCache, etc.)
REDIS_URL=redis://redis:6379/0

# ===========================================
# Storage Configuration
# ===========================================

# Storage type: FILESYSTEM (local), S3 (AWS)
STORAGE_TYPE=FILESYSTEM

# S3 Configuration (only needed if STORAGE_TYPE=S3)
# S3_BUCKET=memorybun-assets
# S3_REGION=eu-north-1
# S3_PREFIX=screenshots

# ===========================================
# Service URLs (Internal - Docker networking)
# ===========================================

# These are set automatically by docker-compose
# Only override if running services separately
# QUESTION_SERVICE_URL=http://question-service:8000
# TRANSCRIPTION_SERVICE_URL=http://transcription-service:8001

# ===========================================
# Whisper Configuration
# ===========================================

# Preload model at startup: base, small, medium, large
WHISPER_PRELOAD_MODEL=base
